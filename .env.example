# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Nothing here has a code-level
# default that assumes a specific deployment region or demo location.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
SERVICE_NAME=flood-rescue-system
TZ=UTC

# --- Google Earth Engine ---
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service_account_key.json
GEE_PROJECT_ID=your-gcp-project-id
GEE_USE_OAUTH=false

SAR_AOI_BUFFER_METERS=5000
SAR_BASELINE_WINDOW_DAYS=30
SAR_POSTFLOOD_WINDOW_DAYS=3
SAR_SPECKLE_FILTER_KERNEL_SIZE=7
SAR_POLARIZATIONS=VV,VH

# --- DEM ---
DEM_DATASET_ID=COPERNICUS/DEM/GLO30
DEM_FALLBACK_DATASET_ID=USGS/SRTMGL1_003

# --- Hazard routing ---
ROUTING_NETWORK_TYPE=drive
ROUTING_GRAPH_BUFFER_METERS=3000
ROUTING_BOAT_SPEED_KMH=15
ROUTING_PEDESTRIAN_SPEED_KMH=4.5

# --- Edge NLP ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEFAULT_LANGUAGE=
AUDIO_SAMPLE_RATE_HZ=16000
AUDIO_CHANNELS=1
AUDIO_MAX_RECORD_SECONDS=30
NER_MODEL_NAME=facebook/bart-large-mnli
NOMINATIM_USER_AGENT=flood-rescue-system
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Binary protocol ---
PROTOCOL_MAX_PACKET_BYTES=40
PROTOCOL_HEADER_BYTE=165
PROTOCOL_VERSION=1

# --- LoRa serial gateway ---
LORA_SERIAL_PORT=/dev/ttyUSB0
LORA_BAUD_RATE=115200
LORA_RECONNECT_DELAY_SECONDS=5

# --- BLE mesh ---
BLE_SERVICE_UUID=6e400001-b5a3-f393-e0a9-e50e24dcca9e
BLE_CHARACTERISTIC_UUID=6e400002-b5a3-f393-e0a9-e50e24dcca9e
BLE_SCAN_INTERVAL_SECONDS=10
BLE_RELAY_QUEUE_MAX_SIZE=500

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./flood_rescue.db
CORS_ALLOW_ORIGINS=*

# --- Dashboard ---
DASHBOARD_API_BASE_URL=http://localhost:8000
DASHBOARD_DEFAULT_MAP_ZOOM=11
DASHBOARD_REFRESH_INTERVAL_SECONDS=15
